{
  "manifest_version": 3,
  "name": "Crawler Spider",
  "version": "0.1.0",
  "description": "A procedural spider that lives on the page, follows your cursor and finds key words.",
  "action": {
    "default_title": "Toggle spider"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "spider.js",
        "reader.js",
        "dwell.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116"
}